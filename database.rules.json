{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "stats": {
          ".read": "auth != null"
        },
        "profile": {
          ".read": "auth != null"
        }
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$roomCode": {
        "rewards": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
