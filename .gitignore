# =============================================
# .gitignore — Tells Git which files to IGNORE.
# These will NEVER be uploaded to GitHub.
# =============================================

# Secret Firebase config (real keys go here — never commit this!)
firebase-config.js

# Firebase local CLI state
.firebase/
firebase-debug.log

# macOS system files
.DS_Store

# Environment variable files
.env
.env.local

# Log files
*.log

# VS Code local settings (optional — remove if you want to share settings)
.vscode/settings.json

# Node modules (not used in this project, but just in case)
node_modules/

# Build output folders (not used, but good practice)
dist/
build/

# Coverage artifacts
coverage-summary.json
coverage/
.nyc_output/

# Playwright
tests/ui/screenshots/
test-results/
playwright-report/
tests/ui/simulation/sim-report.json
tests/ui/simulation/sim-botvsbot-report.json
